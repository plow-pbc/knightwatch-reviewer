[Unit]
Description=Plow PR reviewer — refresh plow-kid mirror + re-index for semantic search
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=odio
Group=odio
WorkingDirectory=/home/odio/.pr-reviewer
Environment=HOME=/home/odio
# PATH: system dirs FIRST (see pr-reviewer-bakeoff.service for rationale —
# defense-in-depth on top of the ~/.local-not-in-ReadWritePaths fix).
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/odio/.local/bin
ExecStart=/home/odio/.pr-reviewer/plow-kid-refresh.sh
# Per-repo index budget is 30min (KID_INDEX_TIMEOUT) and plow alone outgrew the
# old 20min sweep ceiling; the script's lock makes an overlapping hourly fire a no-op.
TimeoutStartSec=3h
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pr-reviewer-kid-refresh

NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHome=read-only
# TWO grants, because tracked repos arrive two ways:
#
# @KWR_CLONE_ROOT@ covers everything org-sync clones. That timer runs hourly
# while install.sh renders this unit only at deploy time, so with the
# enumeration alone a newly-tracked repo sat outside the sandbox and could not
# be indexed until someone re-ran install.sh with sudo — this unit failed
# hourly for three days in Sep 2026, then again within six hours of the deploy
# that cleared it. pr-reviewer-org-sync.service already grants this root for
# the same reason. With it, a repo cloned at 14:05 indexes at 14:30.
#
# @KID_RW_PATHS@ stays because a manual KID_PATHS entry in repos.conf may point
# ANYWHERE (lib/tracked-repos.sh keeps operator overrides and they win over the
# convention default). Those checkouts live outside the clone root, so dropping
# the enumeration would silently leave them read-only and stale.
#
# See pr-reviewer-bakeoff.service for the rationale on excluding /home/odio/.local.
# kid's binary lives at ~/.local/bin/kid (symlink) and
# ~/.local/share/uv/tools/keepitdry/bin/kid (target); both must remain
# read-only so attacker-replaced kid can't be exec'd.
ReadWritePaths=/home/odio/.pr-reviewer @KWR_CLONE_ROOT@ @KID_RW_PATHS@ /home/odio/.cache /home/odio/.config

[Install]
WantedBy=multi-user.target

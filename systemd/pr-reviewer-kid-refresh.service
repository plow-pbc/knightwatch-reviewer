[Unit]
Description=Plow PR reviewer — refresh plow-kid mirror + re-index for semantic search
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=odio
Group=odio
WorkingDirectory=/home/odio/.pr-reviewer
Environment=HOME=/home/odio
# PATH: system dirs FIRST (see pr-reviewer-bakeoff.service for rationale —
# defense-in-depth on top of the ~/.local-not-in-ReadWritePaths fix).
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/odio/.local/bin
ExecStart=/home/odio/.pr-reviewer/plow-kid-refresh.sh
# Per-repo index budget is 30min (KID_INDEX_TIMEOUT) and plow alone outgrew the
# old 20min sweep ceiling; the script's lock makes an overlapping hourly fire a no-op.
TimeoutStartSec=3h
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pr-reviewer-kid-refresh

NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHome=read-only
# @KWR_CLONE_ROOT@ — the checkout root — rather than the per-repo
# @KID_RW_PATHS@ enumeration this unit used to carry. The enumeration kept
# the sandbox minimal, but it was rendered at INSTALL time while org-sync
# discovers and clones repos HOURLY, so every newly-tracked repo landed
# outside the sandbox and could not be indexed until someone re-ran
# install.sh with sudo. That is not a rare edge: it failed this unit every
# hour for three days in Sep 2026, and again within hours of the deploy that
# "fixed" it, because another repo had appeared in between.
#
# pr-reviewer-org-sync.service already resolved the identical problem the
# same way, and documents @KWR_CLONE_ROOT@ as the only shape that works
# without a preceding install.sh re-render. This unit now self-heals: a repo
# cloned at 14:05 indexes on the 14:30 tick, with no deploy in the loop.
#
# What the widening costs is small and bounded. Every path the enumeration
# ever granted was already a child of this root, so the only new reach is
# over directories under the root that are not tracked repos — and org-sync
# holds write on that same tree already. What the comment below actually
# protects is untouched:
# See pr-reviewer-bakeoff.service for the rationale on excluding /home/odio/.local.
# kid's binary lives at ~/.local/bin/kid (symlink) and
# ~/.local/share/uv/tools/keepitdry/bin/kid (target); both must remain
# read-only so attacker-replaced kid can't be exec'd. kid's data lives
# under each tracked repo's .keepitdry/ — covered by @KWR_CLONE_ROOT@.
ReadWritePaths=/home/odio/.pr-reviewer @KWR_CLONE_ROOT@ /home/odio/.cache /home/odio/.config

[Install]
WantedBy=multi-user.target

#!/bin/bash
# Tracked GitHub repos for the knightwatch-reviewer bot.
#
# This file (repos.conf.example) is a TEMPLATE. The live config —
# repos.conf — is per-operator, gitignored, and bootstrapped from this
# template by install.sh on first run. Edit repos.conf, not this file,
# unless you're updating the documented shape.
#
# Single source of truth at runtime — sourced by review.sh,
# learn-from-replies.sh, poll-pr-actions.sh, and lib/review-one-pr.sh.
#
# Whole-org review coverage comes from ORGS (see below): list an org there
# and every non-archived open PR in it is reviewed — new repos included, no
# per-repo manifest edit. REPOS is only for PARTIAL orgs (review just specific
# repos, e.g. some-org/one-repo) and for optional explicit KID_PATHS/SOURCE_PATHS
# wiring (kid-prior-art + cross-repo grep, which stay per-repo opt-in).
#
# To add a partial-org repo (or wire KID/source for one): append a line to
# REPOS and a corresponding entry in each of the two maps below (KID_PATHS,
# SOURCE_PATHS — smoke suite enforces a key per repo). Then run ./install.sh
# on the deployed checkout: adding a KID_PATHS entry widens the kid-refresh
# unit's ReadWritePaths sandbox, which only re-renders on install. A plain
# `git pull` on the deployed checkout is sufficient only when no KID_PATHS key
# was added. (Whole-org repos via ORGS need no REPOS/maps entry at all.)
#
# Per-repo policy (sibling allowlist, product context, review priority,
# dead-code command, strict-typing command) lives in
# <each-repo>/.knightwatch/, NOT here. See lib/knightwatch-config.sh.
#
# KID_PATHS does double duty:
#   - lib/review-one-pr.sh consults it for kid-prior-art lookups
#     (silently skips when the path has no .keepitdry index).
#   - install.sh renders it into pr-reviewer-kid-refresh.service's
#     ReadWritePaths as `<path>` (full root) via @KID_RW_PATHS@ so
#     the hourly refresher can git-pull + re-index.

REPOS=(
    "your-org/example-repo"
)

declare -A KID_PATHS=(
    ["your-org/example-repo"]="$HOME/Hacking/example-repo"
)

# Per-repo source-checkout path. Used by lib/review-one-pr.sh to stage
# .codex-scratch/search-roots.md, the cross-repo grep surface for the
# dead-code-search and consumers specialists. Distinct from KID_PATHS
# (kid-index path, not source) — KID_PATHS may point at a separate
# kid-index dir (e.g. <repo>-kid) while SOURCE_PATHS points at the
# repo source checkout where greppable code actually lives. Empty /
# unset = exclude that repo from the search surface.

declare -A SOURCE_PATHS=(
    ["your-org/example-repo"]="$HOME/Hacking/example-repo"
)

# Orgs reviewed in FULL — the whole-org config alongside the per-repo REPOS
# allowlist above. Each entry is a GitHub org name (NOT org/repo). Every
# non-archived open PR in an ORGS owner is eligible, with no per-repo REPOS
# entry required: a repo created later is reviewed the moment it has a PR, no
# manifest edit. lib/pr-enumerate.sh covers each ORGS owner with ONE batched
# `search(user:<org> is:pr is:open archived:false)` per tick — it does NOT
# fan out per-repo (that would scale GitHub-quota cost with org size on every
# poll). Partial orgs — where you want only specific repos reviewed (e.g.
# some-org/one-repo) — stay OUT of ORGS and list those repos in REPOS, which the
# per-repo fallthrough fetches with a bounded `gh pr list`.
#
# org-sync.sh / pr-reviewer-org-sync.timer also use ORGS (host path only):
# hourly `gh repo list <org> --source --no-archived`, cloning missing repos
# into $HOME/services/kwr-repos/<name> for kid-prior-art. Leave ORGS empty
# to disable both whole-org review and auto-sync.
#   e.g. ORGS=(your-org)   # review every repo in your-org
ORGS=()
